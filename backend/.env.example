# TashTech Onboarding Backend Environment Configuration

# Telegram Bot Credentials
# Obtain bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Group chat ID (e.g. -1001234567890 or @your_group_username)
# Tip: Add your bot as Administrator to your Telegram group to send messages
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_GROUP_CHAT_ID_HERE

# Database URL
DATABASE_URL=sqlite:///./tashtech_submissions.db

# Allowed CORS origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000", "*"]
